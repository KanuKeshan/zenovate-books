NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://claude@127.0.0.1:5433/clarabooks
# Cognito — set by infrastructure, never committed
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1
# Local development only: bypasses Cognito with a signed dev token, any email,
# no password. Refused outright when NODE_ENV=production.
DEV_AUTH_SECRET=

# Real login for a small, named set of people (e.g. owner + accountant) when
# there is no Cognito deployment. LOCAL_AUTH_SECRET is any random string
# (openssl rand -hex 32). Each scryptHash comes from:
#   PASSWORD='the real password' node scripts/hash-password.mjs
# — never put a plaintext password in this file.
LOCAL_AUTH_SECRET=
LOCAL_AUTH_USERS=[{"email":"you@example.com","name":"You","scryptHash":"<salt-hex>:<hash-hex>"}]
